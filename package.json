{
  "name": "subtitulador",
  "version": "1.3.2",
  "description": "Local AI subtitles for macOS: transcribe, translate EN↔ES, style & burn-in",
  "main": "src/main.js",
  "scripts": {
    "vendor": "node scripts/vendor.js && node scripts/fetch-ffmpeg.js",
    "start": "npm run vendor && electron .",
    "test": "node scripts/test.js pipeline",
    "test:compare": "node scripts/test.js compare",
    "dist:mac": "npm run vendor && node scripts/build-mac.js"
  },
  "keywords": [],
  "author": "Adolfo Mesen",
  "license": "MIT",
  "type": "commonjs",
  "devDependencies": {
    "@huggingface/transformers": "4.3.2",
    "electron": "45.1.0",
    "electron-builder": "26.18.0"
  },
  "productName": "Subtitulador",
  "build": {
    "appId": "ar.adolfo.subtitulador",
    "productName": "Subtitulador",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "!src/renderer/selftest.js",
      "package.json"
    ],
    "asar": true,
    "extraResources": [
      {
        "from": "fonts",
        "to": "fonts"
      },
      {
        "from": "staging/bin-${arch}",
        "to": "bin"
      }
    ],
    "mac": {
      "category": "public.app-category.video",
      "target": [
        "zip"
      ],
      "identity": null,
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "icon": "build/icon.png"
    },
    "fileAssociations": [
      {
        "ext": "subtitulador",
        "name": "Proyecto Subtitulador",
        "description": "Proyecto de Subtitulador",
        "role": "Editor",
        "icon": "build/icon.png"
      }
    ],
    "copyright": "Copyright © 2026 Adolfo Mesen",
    "electronFuses": {
      "runAsNode": false,
      "enableCookieEncryption": true,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true,
      "grantFileProtocolExtraPrivileges": false,
      "resetAdHocDarwinSignature": false
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/adolfosmrr/subtitleapp.git"
  },
  "homepage": "https://github.com/adolfosmrr/subtitleapp",
  "engines": {
    "node": ">=20"
  },
  "bugs": {
    "url": "https://github.com/adolfosmrr/subtitleapp/issues"
  }
}
